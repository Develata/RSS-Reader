FeedsPage(BumpReload)
## manual refresh
SetStatus { message: "没有新文章。", tone: "info" }
## export config
FeedsPage(ConfigTextExported("{\n  \"version\": 2,\n  \"exported_at\": \"<time>\",\n  \"feeds\": [\n    {\n      \"url\": \"http://127.0.0.1:<port>/a.xml\",\n      \"title\": \"Feed A\",\n      \"folder\": null\n    },\n    {\n      \"url\": \"http://127.0.0.1:<port>/b.xml\",\n      \"title\": \"Feed B\",\n      \"folder\": null\n    }\n  ],\n  \"settings\": {\n    \"theme\": \"system\",\n    \"list_density\": \"comfortable\",\n    \"startup_view\": \"all\",\n    \"refresh_interval_minutes\": 30,\n    \"archive_after_months\": 3,\n    \"entries_page_size\": 100,\n    \"reader_font_scale\": 1.0,\n    \"custom_css\": \"\"\n  }\n}"))
FeedsPage(SetStatus { message: "已导出配置包 JSON。", tone: "info" })
## export opml
FeedsPage(OpmlTextExported("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<opml version=\"2.0\">\n  <head/>\n  <body>\n    <outline text=\"Feed A\" title=\"Feed A\" type=\"rss\" xmlUrl=\"http://127.0.0.1:<port>/a.xml\"/>\n    <outline text=\"Feed B\" title=\"Feed B\" type=\"rss\" xmlUrl=\"http://127.0.0.1:<port>/b.xml\"/>\n  </body>\n</opml>"))
FeedsPage(SetStatus { message: "已导出 OPML。", tone: "info" })
