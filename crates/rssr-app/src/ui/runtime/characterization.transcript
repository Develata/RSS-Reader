FeedsPage(SetStatus { message: "订阅探测返回非成功状态: HTTP status server error (500 Internal Server Error) for url (http://127.0.0.1:<port>/broken.xml)", tone: "error" })
## add duplicate feed a
FeedsPage(AddFeedFinished { saved: false })
FeedsPage(SetStatus { message: "该地址已订阅：http://127.0.0.1:<port>/a.xml", tone: "error" })
## feeds snapshot
FeedsPage(SnapshotLoaded(Ok(FeedsPageSnapshot { feeds: [FeedSummary { id: 1, title: "Feed A", url: "http://127.0.0.1:<port>/a.xml", unread_count: 3, entry_count: 3, last_fetched_at: Some(<time>), last_success_at: Some(<time>), fetch_error: None }, FeedSummary { id: 2, title: "Feed B", url: "http://127.0.0.1:<port>/b.xml", unread_count: 1, entry_count: 1, last_fetched_at: Some(<time>), last_success_at: Some(<time>), fetch_error: None }], feed_count: 2, entry_count: 4 })))
## entries bootstrap, all
EntriesPage(ApplyLoadedSettings(UserSettings { theme: System, list_density: Comfortable, startup_view: All, refresh_interval_minutes: 30, archive_after_months: 3, entries_page_size: 100, reader_font_scale: 1.0, custom_css: "" }))
EntriesPage(ApplyLoadedWorkspaceState(EntriesWorkspaceState { grouping_mode: Time, show_archived: false, read_filter: All, starred_filter: All, selected_feed_urls: [] }))
EntriesPage(SetFeeds([FeedSummary { id: 1, title: "Feed A", url: "http://127.0.0.1:<port>/a.xml", unread_count: 3, entry_count: 3, last_fetched_at: Some(<time>), last_success_at: Some(<time>), fetch_error: None }, FeedSummary { id: 2, title: "Feed B", url: "http://127.0.0.1:<port>/b.xml", unread_count: 1, entry_count: 1, last_fetched_at: Some(<time>), last_success_at: Some(<time>), fetch_error: None }]))
EntriesPage(PreferencesLoaded)
## entries bootstrap, feed 1
## list entries
EntriesPage(SetEntries { entries: [EntrySummary { id: 4, feed_id: 2, title: "Bravo one", feed_title: "Feed B", published_at: Some(<time>), is_read: false, is_starred: false }, EntrySummary { id: 3, feed_id: 1, title: "Alpha three", feed_title: "Feed A", published_at: Some(<time>), is_read: false, is_starred: false }, EntrySummary { id: 2, feed_id: 1, title: "Alpha two", feed_title: "Feed A", published_at: Some(<time>), is_read: false, is_starred: false }, EntrySummary { id: 1, feed_id: 1, title: "Alpha one", feed_title: "Feed A", published_at: Some(<time>), is_read: false, is_starred: false }], archived_count: 0 })
## list entries of feed 2
EntriesPage(SetEntries { entries: [EntrySummary { id: 4, feed_id: 2, title: "Bravo one", feed_title: "Feed B", published_at: Some(<time>), is_read: false, is_starred: false }], archived_count: 0 })
## toggle read in list
EntriesPage(SetStatus { message: "已将《Alpha one》标记为已读。", tone: "info" })
EntriesPage(PatchEntryFlags { entry_id: 1, is_read: Some(true), is_starred: None })
## toggle starred in list
EntriesPage(SetStatus { message: "已收藏《Alpha two》。", tone: "info" })
EntriesPage(PatchEntryFlags { entry_id: 2, is_read: None, is_starred: Some(true) })
## save browsing preferences
## save the same browsing preferences
## preview mark read
EntriesPage(BulkPreview(MarkReadPreview { query: EntryQuery { feed_id: None, read_filter: All, starred_filter: All, archive_filter: All, feed_ids: [], search_title: None, limit: None }, unread_entry_ids: [2, 3, 4] }))
