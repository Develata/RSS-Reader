## startup route, empty
StartupRouteResolved(StartupRouteSnapshot { route: EntriesPage })
## feeds snapshot, empty
FeedsPage(SnapshotLoaded(Ok(FeedsPageSnapshot { feeds: [], feed_count: 0, entry_count: 0 })))
## add feed a
FeedsPage(AddFeedFinished { saved: true })
FeedsPage(SetStatus { message: "订阅已保存并完成首次刷新。", tone: "info" })
FeedsPage(BumpReload)
## add feed b
FeedsPage(AddFeedFinished { saved: true })
FeedsPage(SetStatus { message: "订阅已保存并完成首次刷新。", tone: "info" })
FeedsPage(BumpReload)
## add discovery page
FeedsPage(FeedCandidates { page_url: Url { scheme: "http", cannot_be_a_base: false, username: "", password: None, host: Some(Ipv4(127.0.0.1)), port: Some(<port>), path: "/page.html", query: None, fragment: None }, candidates: [FeedDiscoveryCandidate { url: Url { scheme: "http", cannot_be_a_base: false, username: "", password: None, host: Some(Ipv4(127.0.0.1)), port: Some(<port>), path: "/a.xml", query: None, fragment: None }, title: Some("First") }, FeedDiscoveryCandidate { url: Url { scheme: "http", cannot_be_a_base: false, username: "", password: None, host: Some(Ipv4(127.0.0.1)), port: Some(<port>), path: "/b.xml", query: None, fragment: None }, title: Some("Second") }] })
FeedsPage(AddFeedFinished { saved: false })
